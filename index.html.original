Join DAREDOWN
</h2> <p class="text-center text-white/70 mt-4 text-[18px]">16 spots available, £0.50 entry, £50 prize</p> <div class="mt-8 flex justify-center"><a href="register/index.html" class="border border-white/40 px-8 py-3 text-sm uppercase tracking-[0.2em] text-white transition-colors hover:bg-white hover:text-black">Register Now</a></div> </div>  </div> </div> </div> <script>(function(){const id = "application";
const closeOnBackdrop = true;

  (() => {
    const TOKEN_KEY = "ngt_token";
    const modal = document.querySelector(`[data-modal="${id}"]`);
    if (!(modal instanceof HTMLElement)) return;

    let lastFocused = null;
    let closeTimeout = null;
    const closeAnimationMs = 320;

    const setQueryParam = (isOpen) => {
      const url = new URL(window.location.href);
      if (isOpen) {
        url.searchParams.set("modal", id);
      } else if (url.searchParams.get("modal") === id) {
        url.searchParams.delete("modal");
      }

      window.history.replaceState(
        {},
        "",
        `${url.pathname}${url.search}${url.hash}`,
      );
    };

    const redirectToLogin = () => {
      const nextUrl = new URL(window.location.href);
      nextUrl.searchParams.set("modal", id);
      const next = `${nextUrl.pathname}${nextUrl.search}`;
      window.location.href = `/login?next=${encodeURIComponent(next)}`;
    };

    const shouldRedirectToLogin = () => {
      if (id !== "application") {
        return false;
      }

      const token = localStorage.getItem(TOKEN_KEY);
      if (token) {
        return false;
      }

      redirectToLogin();
      return true;
    };

    const openModal = () => {
      if (shouldRedirectToLogin()) {
        return;
      }

      if (closeTimeout) {
        window.clearTimeout(closeTimeout);
        closeTimeout = null;
      }

      if (!modal.classList.contains("hidden")) {
        return;
      }

      lastFocused = document.activeElement;
      modal.classList.remove("hidden");
      modal.classList.add("flex");
      document.body.classList.add("overflow-hidden");
      setQueryParam(true);

      requestAnimationFrame(() => {
        modal.classList.add("is-open");
        modal.setAttribute("aria-hidden", "false");
      });
    };

    const closeModal = () => {
      if (modal.classList.contains("hidden")) {
        return;
      }

      if (closeTimeout) {
        window.clearTimeout(closeTimeout);
        closeTimeout = null;
      }

      modal.setAttribute("aria-hidden", "true");
      modal.classList.remove("is-open");
      document.body.classList.remove("overflow-hidden");
      setQueryParam(false);

      closeTimeout = window.setTimeout(() => {
        modal.classList.add("hidden");
        modal.classList.remove("flex");
        closeTimeout = null;

        if (lastFocused instanceof HTMLElement) {
          lastFocused.focus();
        }
      }, closeAnimationMs);
    };

    const openers = document.querySelectorAll(`[data-modal-open="${id}"]`);
    openers.forEach((opener) => {
      opener.addEventListener("click", (event) => {
        event.preventDefault();
        openModal();
      });
    });

    const closers = document.querySelectorAll(`[data-modal-close="${id}"]`);
    closers.forEach((closer) => {
      closer.addEventListener("click", (event) => {
        event.preventDefault();
        closeModal();
      });
    });

    if (closeOnBackdrop) {
      modal.addEventListener("click", (event) => {
        if (event.target === modal) {
          closeModal();
        }
      });
    }

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && !modal.classList.contains("hidden")) {
        closeModal();
      }
    });

    const params = new URLSearchParams(window.location.search);
    if (params.get("modal") === id) {
      if (shouldRedirectToLogin()) {
        return;
      }

      openModal();
    }
  })();
})();
</script> <div id="vs-screen" data-vs-modal class="hidden" role="dialog" aria-modal="true" aria-hidden="true"> <div class="vs-screen__panel" data-vs-panel> <div class="vs-screen__topbar"> <button type="button" class="vs-screen__close" data-vs-close aria-label="Close VS screen">
