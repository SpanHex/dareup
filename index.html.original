<script>
  (() => {
    const viewport = document.getElementById("bracket-viewport");
    const stage = document.getElementById("bracket-stage");
    const chips = document.querySelectorAll(".bracket-round-chip");
    if (!viewport || !stage || chips.length === 0) return;

    chips.forEach((chip) => {
      chip.addEventListener("click", () => {
        chips.forEach((c) => c.classList.remove("is-active"));
        chip.classList.add("is-active");
        const r = chip.dataset.round;
        const maxScroll = Math.max(0, stage.scrollWidth - viewport.clientWidth);
        if (r === "1") {
          viewport.scrollTo({ left: 0, behavior: "smooth" });
        } else if (r === "2") {
          viewport.scrollTo({ left: maxScroll * 0.28, behavior: "smooth" });
        } else if (r === "3") {
          viewport.scrollTo({ left: maxScroll * 0.40, behavior: "smooth" });
        } else if (r === "4") {
          viewport.scrollTo({ left: maxScroll * 0.50, behavior: "smooth" });
        }
      });
    });

    const hint = document.querySelector(".bracket-swipe-hint");
    if (hint) {
      viewport.addEventListener("scroll", () => {
        hint.style.transition = "opacity 0.6s ease";
        hint.style.opacity = "0";
        setTimeout(() => { hint.style.display = "none"; }, 600);
      }, { once: true, passive: true });
    }
  })();
</script>   </div>    <div class="flex flex-col gap-12.5 pt-12 md:pt-16" id="about" data-astro-cid-rsd2vusr> <h2 class="block-title text-white text-center" data-astro-cid-rsd2vusr> About </h2>  <div id="about-reveal"> <p id="about-heading" class="px-4 text-[clamp(2rem,8.6vw,8rem)] font-bold text-white text-center max-w-345 mx-auto uppercase leading-[0.96]"> <span class="word-clip" style="--word-index:0;"> <span class="word-inner">DARE</span> </span><span class="word-clip" style="--word-index:1;"> <span class="word-inner">TO</span> </span><span class="word-clip" style="--word-index:2;"> <span class="word-inner">SURVIVE.</span> </span> </p> <p id="about-body" class="px-4 text-[clamp(0.95rem,1.8vw,1.5rem)] text-white text-center max-w-275 mx-auto mt-4 md:mt-7.5 leading-tight font-medium"> <span class="word-clip" style="--word-index:3;"> <span class="word-inner">DAREDOWN</span> </span><span class="word-clip" style="--word-index:4;"> <span class="word-inner">is</span> </span><span class="word-clip" style="--word-index:5;"> <span class="word-inner">a</span> </span><span class="word-clip" style="--word-index:6;"> <span class="word-inner">live</span> </span><span class="word-clip" style="--word-index:7;"> <span class="word-inner">Truth</span> </span><span class="word-clip" style="--word-index:8;"> <span class="word-inner">or</span> </span><span class="word-clip" style="--word-index:9;"> <span class="word-inner">Dare</span> </span><span class="word-clip" style="--word-index:10;"> <span class="word-inner">elimination</span> </span><span class="word-clip" style="--word-index:11;"> <span class="word-inner">tournament.</span> </span><span class="word-clip" style="--word-index:12;"> <span class="word-inner">16</span> </span><span class="word-clip" style="--word-index:13;"> <span class="word-inner">players.</span> </span><span class="word-clip" style="--word-index:14;"> <span class="word-inner">Random</span> </span><span class="word-clip" style="--word-index:15;"> <span class="wor