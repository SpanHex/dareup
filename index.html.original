  (() => {
    window.addEventListener("siteSettings:loaded", (event) => {
      const videoUrl = event.detail?.backgroundVideoUrl;
      if (!videoUrl || videoUrl.includes("background_v1783289610658.mp4")) return;
      const bgVideo = document.querySelector("#hero-bg-video-layer video");
      if (!(bgVideo instanceof HTMLVideoElement)) return;
      const source = bgVideo.querySelector("source");
      if (source instanceof HTMLSourceElement) {
        source.setAttribute("src", videoUrl);
        bgVideo.load();
        bgVideo.play().catch(() => {});
      }
    });
  })();
