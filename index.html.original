hird" data-astro-cid-6ur5r5pq> <svg class="winner-rank-number rank-bronze" viewBox="0 0 430 720" aria-hidden="true" data-astro-cid-6ur5r5pq> <defs data-astro-cid-6ur5r5pq> <linearGradient id="winner-rank-bronze" x1="-50" y1="720" x2="460" y2="130" gradientUnits="userSpaceOnUse" data-astro-cid-6ur5r5pq> <stop stop-color="#C78A56" data-astro-cid-6ur5r5pq></stop> <stop offset="1" stop-color="#56361C" data-astro-cid-6ur5r5pq></stop> </linearGradient> </defs> <text class="winner-rank-text" x="28" y="655" fill="url(#winner-rank-bronze)" data-astro-cid-6ur5r5pq> 3 </text> </svg> <div class="winner-detail third-detail" data-astro-cid-6ur5r5pq> <p class="winner-place" data-astro-cid-6ur5r5pq>3RD PLACE</p> <span class="winner-rule" data-astro-cid-6ur5r5pq></span> <h3 data-astro-cid-6ur5r5pq> <a class="winner-name-link" data-winner-name data-winner-place="third" data-astro-cid-6ur5r5pq> TBD </a> </h3> <svg class="winner-prize prize-bronze" viewBox="0 0 500 230" role="img" aria-label="Survived" data-astro-cid-6ur5r5pq> <title>Survived</title> <defs data-astro-cid-6ur5r5pq> <linearGradient id="winner-prize-bronze" x1="-20" y1="180" x2="430" y2="20" gradientUnits="userSpaceOnUse" data-astro-cid-6ur5r5pq> <stop stop-color="#C78A56" data-astro-cid-6ur5r5pq></stop> <stop offset="1" stop-color="#56361C" data-astro-cid-6ur5r5pq></stop> </linearGradient> </defs> <text class="winner-prize-text" x="16" y="170" fill="url(#winner-prize-bronze)" data-astro-cid-6ur5r5pq style="font-size:0.65em"> Survived </text> </svg> <p class="winner-title" data-winner-title data-winner-place="third" data-astro-cid-6ur5r5pq> THE BRAVE </p> </div> </article> </div> </section>   </div> </div> </div> </section>  <script>
  (() => {
    const root = document.getElementById("hero-winners-transition");
    if (!(root instanceof HTMLElement)) return;

    const prefersReducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    );
    const winnersLayer = root.querySelector("[data-transition-winners]");
    const winnerLinks = Array.from(root.querySelectorAll(".winner-name-link"));
    let frame = 0;
    let reducedMotion = prefersReducedMotion.matches;

    const clamp = (value, min = 0, max = 1) =>
      Math.min(max, Math.max(min, value));

    const easeOut = (value) => 1 - Math.pow(1 - clamp(value), 3);

    const range = (progress, start, end) =>
      clamp((progress - start) / (end - start));

    const reveal = (progress, start, end) => easeOut(range(progress, start, end));

    const setHiddenLinks = (hidden) => {
      if (winnersLayer instanceof HTMLElement) {
        winnersLayer.toggleAttribute("inert", hidden);
        winnersLayer.setAttribute("aria-hidden", hidden ? "true" : "false");
      }

      winnerLinks.forEach((link) => {
        if (!(link instanceof HTMLElement)) return;
        if (hidden) {
          if ("transitionPreviousTabindex" in link.dataset) return;
          link.dataset.transitionPreviousTabindex =
            link.getAttribute("tabindex") ?? "";
          link.setAttribute("tabindex", "-1");
        } else if ("transitionPreviousTabindex" in link.dataset) {
          const previous = link.dataset.transitionPreviousTabindex;
          if (previous) {
            link.setAttribute("tabindex", previous);
          } else {
            link.removeAttribute("tabindex");
          }
          delete link.dataset.transitionPreviousTabindex;
        }
      });
    };

    const setVar = (name, value) => {
      root.style.setProperty(name, value);
    };

    
    const updateWinnersLayout = () => {
      if (window.innerWidth <= 900) {
        setVar("--winners-scale", "1");
        setVar("--winners-section-offset", "0px");
        return;
      }
      const vh = window.innerHeight;
      const header = document.getElementById("site-header");
      const headerH = header ? header.getBoundingClientRect().height : 90;
      
      // Total vertical span of the winners content from top of title (25px) to bottom of card 2 (1060px) is 1060px.
      const targetH = 1060;
      const topPadding = Math.max(headerH + 8, 92);
      const bottomPadding = 20;
      const availableH = Math.max(280, vh - topPadding - bottomPadding);
      const scale = Math.min(1, Math.max(0.40, availableH / targetH));
      const offset = topPadding - (25.6 * scale);
      
      setVar("--winners-scale", scale.toFixed(4));
      setVar("--winners-section-offset", offset.toFixed(1) + "px");
      setVar("--winners-visual-height", (targetH * scale + offset).toFixed(1) + "px");
    };

    const applyProgress = () => {
      frame = 0;
      updateWinnersLayout();

      if (reducedMotion) {
        setHiddenLinks(false);
        return;
      }

      const rect = root.getBoundingClientRect();
      const distance = Math.max(1, root.offsetHeight - window.innerHeight);
      const progress = clamp(-rect.top / distance);
      const heroOpacity = 1 - reveal(progress, 0, 0.24);
      const titleProgress = reveal(progress, 0.25, 0.38);
      const firstProgress = reveal(progress, 0.4, 0.58);
      const secondProgress = reveal(progress, 0.56, 0.74);
      const thirdProgress = reveal(progress, 0.72, 0.9);
      const winnersOpacity = Math.max(
        titleProgress,
        firstProgress,
        secondProgress,
        thirdProgress,
      );

      setVar("--hero-opacity", heroOpacity.toFixed(4));
      setVar("--winners-opacity", winnersOpacity.toFixed(4));
      setVar("--winners-title-opacity", titleProgress.toFixed(4));
      setVar(
        "--winners-title-y",
        `${((1 - titleProgress) * 1.15).toFixed(3)}rem`,
      );
      setVar("--winner-first-opacity", firstProgress.toFixed(4));
      setVar("--winner-first-y", `${((1 - firstProgress) * 5.5).toFixed(3)}rem`);
      setVar("--winner-second-opacity", secondProgress.toFixed(4));
      setVar(
        "--winner-second-y",
        `${((1 - secondProgress) * 5.5).toFixed(3)}rem`,
      );
      setVar("--winner-third-opacity", thirdProgress.toFixed(4));
      setVar("--winner-third-y", `${((1 - thirdProgress) * 5.5).toFixed(3)}rem`);
      setHiddenLinks(winnersOpacity < 0.98);
    };

    const requestSync = () => {
      if (frame) return;
      frame = window.requestAnimationFrame(applyProgress);
    };

    const scrollToFinalWinners = () => {
      const distance = Math.max(1, root.offsetHeight - window.innerHeight);
      const top = root.getBoundingClientRect().top + window.scrollY;
      window.scrollTo(0, top + distance);
    };

    const handleReducedMotion = () => {
      reducedMotion = prefersReducedMotion.matches;
      if (reducedMotion) {
        root.removeAttribute("data-transition-active");
        root.style.cssText = "";
      } else {
        root.setAttribute("data-transition-active", "true");
      }
      requestSync();
    };

    const syncInitialHash = () => {
      if (window.location.hash !== "#winners" || reducedMotion) return;
      window.requestAnimationFrame(() => {
        scrollToFinalWinners();
        requestSync();
      });
    };

    handleReducedMotion();
    syncInitialHash();
    window.addEventListener("scroll", requestSync, { passive: true });
    window.addEventListener("resize", () => { updateWinnersLayout(); requestSync(); });
    prefersReducedMotion.addEventListener?.("change", handleReducedMotion);
    window.addEventListener("pageshow", () => {
      updateWinnersLayout();
      syncInitialHash();
      requestSync();
    });
    window.addEventListener("load", () => {
      updateWinnersLayout();
      syncInitialHash();
      window.setTimeout(() => {
        updateWinnersLayout();
        syncInitialHash();
      }, 120);
      window.setTimeout(() => {
        updateWinnersLayout();
        syncInitialHash();
      }, 500);
    });
  })();
</script> <div class="flex flex-col items-center justify-start gap-2 md:gap-3 pt-24 md:pt-[126px] pb-6 md:pb-10 overflow-hidden" id="bracket" data-astro-cid-rsd2vusr> <h2 class="block-title text-white text-center" data-astro-cid-rsd2vusr> TOURNAMENT BRACKET </h2>  <div class="w-full px-2 md:px-4"> <div id="bracket-shell" class="w-full flex flex-col items-center gap-4" data-stub-mode="auto" data-empty-text="Bracket is not available yet." data-total-rounds="4" data-total-participants="16"> <p id="bracket-status" class="text-[10px] md:text-xs uppercase tracking-[0.2em] text-white/45 text-center hidden" aria-live="polite"></p> <div id="bracket-content" class="w-full">
