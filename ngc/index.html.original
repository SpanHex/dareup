  </div>

  <main class="challenges-main">

    <!-- Title -->
    <div class="challenges-header-row">
      <span class="challenges-eyebrow">DAREDOWN ~ Challenge Pool</span>
      <h1 class="challenges-title">Truth &amp; Dare</h1>
      <p class="challenges-sub">
        These are the challenges you'll face in the tournament.
        All challenges are assigned live by the host, randomly selected from this pool.
        Come prepared for anything.
      </p>
    </div>

    <!-- Filters -->
    <div class="challenges-filters" role="group" aria-label="Filter challenges">
      <button class="challenges-filter-btn is-active" id="filter-all" data-filter="all" type="button">All</button>
      <button class="challenges-filter-btn is-truth" id="filter-truth" data-filter="truth" type="button">Truth</button>
      <button class="challenges-filter-btn is-dare" id="filter-dare" data-filter="dare" type="button">Dare</button>
    </div>

    <!-- Challenge Cards -->
    <div class="challenges-grid" id="challenges-grid">
      <!-- Populated by JS from challenges.json -->
    </div>

    <!-- CTA -->
    <div class="challenges-cta">
      <h2 class="challenges-cta-title">Think you can handle it?</h2>
      <p class="challenges-cta-sub">£0.50 entry. £50 prize. 16 spots. First come, first served.</p>
      <a href="../register/index.html" class="challenges-cta-btn" id="cta-register-btn">Register Now</a>
    </div>

  <script src="/_astro/bundle.ngc.js"></script></main>

  <!-- Footer -->
  <div>
    <img class="relative bottom-[-8px] px-3 w-full max-w-450 mx-auto" src="/footer_newgen.svg" alt="DAREDOWN">
    <footer class="w-full px-3 md:px-18 py-5 bg-white">
      <div class="max-w-450 w-full mx-auto grid grid-cols-1 gap-8 items-start sm:grid-cols-2 lg:grid-cols-4 lg:items-stretch lg:gap-10">
        <div class="decoration-transparent decoration-0 text-black text-[18px] leading-tight tracking-tight flex flex-col gap-3 sm:text-[20px] lg:text-[24px] lg:gap-7.5">
          <span>DAREDOWN</span>
          <span>TRUTH OR DARE</span>
          <span>TOURNAMENT</span>
        </div>
        <ol class="decoration-transparent decoration-0 text-black text-[18px] leading-tight tracking-tight flex flex-col gap-3 sm:text-[20px] lg:text-[24px] lg:gap-7.5">
          <li><a class="transition-colors duration-130 hover:text-black/70 hover:underline" href="../rules/index.html">Rules</a></li>
          <li><a class="transition-colors duration-130 hover:text-black/70 hover:underline" href="../index.html#bracket">Bracket</a></li>
          <li><a class="transition-colors duration-130 hover:text-black/70 hover:underline" href="index.html">Challenges</a></li>
          <li><a class="transition-colors duration-130 hover:text-black/70 hover:underline" href="../index.html#about">About</a></li>
        </ol>
        <ol class="decoration-transparent decoration-0 text-black text-[18px] leading-tight tracking-tight flex flex-col gap-3 sm:text-[20px] lg:text-[24px] lg:gap-7.5">
          <li><a class="transition-colors duration-130 hover:text-black/70 hover:underline" href="../register/index.html">Register</a></li>
        </ol>
        <div class="w-full flex flex-col gap-3 text-black text-[18px] leading-tight tracking-tight sm:text-[20px] lg:text-[24px] lg:gap-7.5">
          <span>Hosted by the crew</span>
        </div>
      </div>
    </footer>
  </div>

  <script>
    (() => {
      // Header bg on scroll
      const header = document.getElementById('site-header');
      if (header) {
        const toggleBg = () => header.classList.toggle('header-bg', window.scrollY > 0);
        toggleBg();
        window.addEventListener('scroll', toggleBg, { passive: true });
      }

      // Load challenges from challenges.json
      const grid = document.getElementById('challenges-grid');
      if (!grid) return;

      const renderCard = (challenge) => {
        const difficulty = challenge.difficulty || 1;
        const dots = [1,2,3].map(i =>
          `<span class="challenge-difficulty-dot ${i <= difficulty ? 'is-filled' : ''}"></span>`
        ).join('');

        return `
          <div class="challenge-card" data-type="${challenge.type}" data-challenge-id="${challenge.id}">
            <div class="challenge-type-badge">${challenge.type.toUpperCase()}</div>
            <p class="challenge-text">${challenge.text}</p>
            <div class="challenge-difficulty" aria-label="Difficulty: ${difficulty} of 3">${dots}</div>
          </div>
        `;
      };

      let allChallenges = [];
      let activeFilter = 'all';

      const applyFilter = (filter) => {
        activeFilter = filter;
        const cards = grid.querySelectorAll('.challenge-card');
        cards.forEach(card => {
          const type = card.dataset.type;
          card.style.display = (filter === 'all' || filter === type) ? '' : 'none';
        });

        document.querySelectorAll('.challenges-filter-btn').forEach(btn => {
          btn.classList.toggle('is-active', btn.dataset.filter === filter);
        });
      };

      // Wire filter buttons
      document.querySelectorAll('.challenges-filter-btn').forEach(btn => {
        btn.addEventListener('click', () => applyFilter(btn.dataset.filter));
      });

      // Fetch challenge pool
      fetch('../challenges.json')
        .then(r => r.json())
        .then(data => {
          allChallenges = (data.challenges || []).filter(c => c.active !== false);
          // Shuffle for a fresh look each visit
          allChallenges.sort(() => Math.random() - 0.5);
          grid.innerHTML = allChallenges.map(renderCard).join('');
          applyFilter(activeFilter);
        })
        .catch(() => {
          // Fallback if fetch fails
          grid.innerHTML = `
            <div style="grid-column:1/-1;text-align:center;padding:60px;color:rgba(255,255,255,0.4);">
              <p style="font-size:0.85rem;letter-spacing:0.1em;text-transform:uppercase;">
                Challenge pool will be revealed closer to the event date.
              </p>
            </div>
          `;
        });
    })();
  </script>
  <script src="/auth-client.js"></script>
</body>
</html>